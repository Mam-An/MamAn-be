generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RefreshToken {
  id          Int      @id @default(autoincrement())
  userId      String?  @db.Uuid
  hashedToken String   @unique @db.VarChar(255)
  revoked     Boolean  @default(false)
  expiresAt   DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("RefreshToken")
}

enum UserRole {
  USER
  FARMER
  ADMIN
}

enum PlantStatus {
  SEED
  SPROUT
  GROWING
  BUDDING
  BLOOMING
  RESTING
  NEEDS_CARE
  COMPLETED
}

enum MoodType {
  HAPPY
  CALM
  NORMAL
  SAD
  ANXIOUS
  TIRED
}

enum ReminderType {
  PLANT_REMINDER
  JOURNAL_REMINDER
  GARDEN_YEN_REMINDER
}

enum NotificationStatus {
  SUCCESS
  FAILED
  PENDING
}

enum GardenStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CareTaskType {
  WATER_PLANT
  BREATHING
  DRINK_WATER
  WRITE_JOURNAL
  LISTEN_SOUND
  SHORT_WALK
}

enum TaskVerifyType {
  SELF_CONFIRM
  TIMER
  PHOTO_REQUIRED
  PHOTO_OPTIONAL
}

enum PlantResourceType {
  WATER
  SUNLIGHT
  FERTILIZER
  AIR
  LOVE
  DEW
}

enum CommunityPostVisibility {
  PUBLIC
  ANONYMOUS
}

enum CommunityPostStatus {
  VISIBLE
  HIDDEN
  REPORTED
  REJECTED
}

enum CommunityReactionType {
  LOVE
  LIGHT
  SPROUT
  HUG
  THANKS
}

enum PlanCode {
  FREE
  VIRTUAL_PLUS
  SUNFLOWER_COMPANION
  SUNFLOWER_PREMIUM_GIFT
}

enum PlanType {
  FREE
  SUBSCRIPTION
  ONE_TIME
}

enum PlantMode {
  VIRTUAL
  REAL
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  FULFILLING
  COMPLETED
}

enum PaymentMethod {
  MANUAL_BANK_TRANSFER
  CASH
  MOMO
  ZALOPAY
  OTHER
}

enum GiftRecipientType {
  SELF
  FRIEND
  DONATION
}

enum ShippingStatus {
  NOT_REQUIRED
  PENDING
  PREPARING
  SHIPPING
  DELIVERED
  FAILED
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique @db.VarChar(254)
  passwordHash  String   @db.VarChar(255)
  fullName      String?  @db.VarChar(150)
  avatarUrl     String?  @db.VarChar(500)
  role          UserRole @default(USER)
  isActive      Boolean  @default(true)
  expoPushToken String?  @db.VarChar(500)
  lastActiveAt  DateTime @default(now()) @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  gardens      Garden[]      @relation("FarmerGardens")
  plantUpdates PlantUpdate[] @relation("FarmerPlantUpdates")

  virtualPlants      VirtualPlant[]
  moodJournals       MoodJournal[]
  careTaskLogs       CareTaskLog[]
  communityPosts     CommunityPost[]
  communityReactions CommunityReaction[]
  communityReports   CommunityReport[]   @relation("UserReports")
  refreshTokens      RefreshToken[]
  devices            UserDevice[]
  notifications      Notification[]
  notificationLogs   NotificationLog[]
  notificationSetting UserNotificationSetting?

  subscriptions UserSubscription[]
  orders        Order[]

  userPoints     UserPoints?
  unlockedTracks UserUnlockedTrack[]

  userAchievements UserAchievement[]

  flowerHarvests   FlowerHarvest[]

  plantReactions PlantReaction[]
  plantComments  PlantComment[]

  // Companion relations
  companionRequests     CompanionRequest[]
  companionshipsAsUser1 Companionship[]    @relation("CompanionUser1")
  companionshipsAsUser2 Companionship[]    @relation("CompanionUser2")
  companionMessages     CompanionMessage[] @relation("CompanionMessageSender")

  @@map("User")
}

model Garden {
  id             String       @id @default(uuid()) @db.Uuid
  name           String       @db.VarChar(255)
  address        String?      @db.VarChar(500)
  description    String?      @db.Text
  imageUrl       String?      @db.VarChar(500)
  isActive       Boolean      @default(true)
  status         GardenStatus @default(PENDING)
  rejectedReason String?      @db.Text

  farmerId String @db.Uuid
  farmer   User   @relation("FarmerGardens", fields: [farmerId], references: [id], onDelete: Restrict)

  realPlants RealPlant[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([farmerId])
  @@index([status])
  @@map("Garden")
}

model FlowerType {
  id              String  @id @default(uuid()) @db.Uuid
  name            String  @unique @db.VarChar(255)
  description     String? @db.Text
  imageUrl        String? @db.VarChar(500)
  defaultDuration Int?

  stageImages Json?

  stageDurations Json?

  isActive Boolean @default(true)

  realPlants     RealPlant[]
  virtualPlants  VirtualPlant[]
  flowerHarvests FlowerHarvest[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("FlowerType")
}

model ZenFlower {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique @db.VarChar(255)
  imageUrl String? @db.VarChar(500)
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("ZenFlower")
}

model RealPlant {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(50)

  status      PlantStatus @default(SEED)
  isAssigned  Boolean     @default(false)
  plantedAt   DateTime?   @db.Date
  completedAt DateTime?   @db.Date

  flowerTypeId String     @db.Uuid
  flowerType   FlowerType @relation(fields: [flowerTypeId], references: [id], onDelete: Restrict)

  gardenId String @db.Uuid
  garden   Garden @relation(fields: [gardenId], references: [id], onDelete: Restrict)

  virtualPlant VirtualPlant?
  updates      PlantUpdate[]
  orders       Order[]

  reactions     PlantReaction[]
  comments      PlantComment[]
  companionships Companionship[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([gardenId])
  @@index([flowerTypeId])
  @@index([flowerTypeId, isAssigned, status])
  @@map("RealPlant")
}

model PlantReaction {
  id    String @id @default(uuid()) @db.Uuid
  emoji String @db.VarChar(10)

  realPlantId String    @db.Uuid
  realPlant   RealPlant @relation(fields: [realPlantId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([realPlantId, userId])
  @@index([realPlantId])
  @@map("PlantReaction")
}

model PlantComment {
  id      String @id @default(uuid()) @db.Uuid
  content String @db.VarChar(500)

  realPlantId String    @db.Uuid
  realPlant   RealPlant @relation(fields: [realPlantId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([realPlantId])
  @@map("PlantComment")
}

model VirtualPlant {
  id       String  @id @default(uuid()) @db.Uuid
  nickname String? @db.VarChar(100)

  status      PlantStatus @default(SEED)
  growthPoint Int         @default(0)
  streakCount Int         @default(0)

  waterAmount      Int       @default(0)
  sunlightAmount   Int       @default(0)
  fertilizerAmount Int       @default(0)
  airAmount        Int       @default(0)
  loveAmount       Int       @default(0)
  dewAmount        Int       @default(0)
  lastCaredAt      DateTime? @db.Timestamptz(3)
  resourceUsage    Json?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  flowerTypeId String     @db.Uuid
  flowerType   FlowerType @relation(fields: [flowerTypeId], references: [id], onDelete: Restrict)

  realPlantId String?    @unique @db.Uuid
  realPlant   RealPlant? @relation(fields: [realPlantId], references: [id], onDelete: Restrict)

  careTaskLogs    CareTaskLog[]
  flowerHarvests  FlowerHarvest[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([flowerTypeId])
  @@map("VirtualPlant")
}

model PlantUpdate {
  id String @id @default(uuid()) @db.Uuid

  realPlantId String    @db.Uuid
  realPlant   RealPlant @relation(fields: [realPlantId], references: [id], onDelete: Cascade)

  farmerId String @db.Uuid
  farmer   User   @relation("FarmerPlantUpdates", fields: [farmerId], references: [id], onDelete: Restrict)

  imageUrl   String      @db.VarChar(500)
  status     PlantStatus
  note       String?     @db.Text
  healthNote String?     @db.VarChar(500)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([realPlantId, createdAt])
  @@index([farmerId])
  @@map("PlantUpdate")
}

model MoodJournal {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mood MoodType
  note String?  @db.Text

  aiReply    String? @db.Text
  aiMetadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("MoodJournal")
}

model CareTask {
  id          String       @id @default(uuid()) @db.Uuid
  title       String       @db.VarChar(255)
  description String?      @db.Text
  type        CareTaskType
  isDefault   Boolean      @default(true)
  isActive    Boolean      @default(true)
  isShareable Boolean      @default(false)

  rewardResource  PlantResourceType @default(WATER)
  rewardAmount    Int               @default(10)
  growthReward    Int               @default(5)
  verifyType      TaskVerifyType    @default(SELF_CONFIRM)
  durationSeconds Int?

  characterImageUrl String? @db.VarChar(500)

  logs CareTaskLog[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("CareTask")
}

model CareTaskLog {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  virtualPlantId String?       @db.Uuid
  virtualPlant   VirtualPlant? @relation(fields: [virtualPlantId], references: [id], onDelete: SetNull)

  careTaskId String   @db.Uuid
  careTask   CareTask @relation(fields: [careTaskId], references: [id], onDelete: Restrict)

  taskDate    DateTime @db.Date
  completedAt DateTime @default(now()) @db.Timestamptz(3)

  note               String? @db.Text
  photoUrl           String? @db.VarChar(500)
  cloudinaryPublicId String? @db.VarChar(255)
  sharedToCommunity  Boolean @default(false)

  communityPost CommunityPost?

  @@unique([userId, careTaskId, taskDate])
  @@index([userId, completedAt])
  @@index([virtualPlantId])
  @@index([careTaskId])
  @@map("CareTaskLog")
}

model CommunityPost {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskLogId String?      @unique @db.Uuid
  taskLog   CareTaskLog? @relation(fields: [taskLogId], references: [id], onDelete: SetNull)

  content  String? @db.Text
  imageUrl String? @db.VarChar(500)

  visibility  CommunityPostVisibility @default(ANONYMOUS)
  status      CommunityPostStatus     @default(VISIBLE)
  reportCount Int                     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  reactions CommunityReaction[]
  reports   CommunityReport[]

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@map("CommunityPost")
}

model CommunityReaction {
  id String @id @default(uuid()) @db.Uuid

  postId String        @db.Uuid
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      CommunityReactionType
  createdAt DateTime              @default(now()) @db.Timestamptz(3)

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
  @@map("CommunityReaction")
}

model CommunityReport {
  id String @id @default(uuid()) @db.Uuid

  postId String        @db.Uuid
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  reporterId String @db.Uuid
  reporter   User   @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)

  reason String  @db.VarChar(255)
  note   String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([postId])
  @@index([reporterId])
  @@map("CommunityReport")
}

model UserDevice {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fcmToken String  @unique @db.VarChar(500)
  platform String? @db.VarChar(50)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("UserDevice")
}

model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title  String  @db.VarChar(255)
  body   String  @db.Text
  type   String? @db.VarChar(50)
  isRead Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("Notification")
}

model NotificationLog {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   ReminderType
  title  String       @db.VarChar(255)
  body   String       @db.Text
  status NotificationStatus @default(PENDING)
  error  String?      @db.Text

  sentAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([type])
  @@map("NotificationLog")
}

model UserNotificationSetting {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enablePlantReminder     Boolean @default(true)
  enableJournalReminder   Boolean @default(true)
  enableGardenYenReminder Boolean @default(true)

  reminderTime String @default("21:00")

  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("UserNotificationSetting")
}

model CalmMusicTrack {
  id String @id @default(uuid()) @db.Uuid

  titleVi String @db.VarChar(255)

  hasLyrics Boolean @default(false)

  category String @default("general") @db.VarChar(100)

  storagePath String @unique @db.VarChar(500)

  publicUrl String @db.VarChar(500)

  originalName String? @db.VarChar(255)

  isFree Boolean @default(true)

  pointCost Int @default(50)

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  unlockedBy UserUnlockedTrack[]

  @@index([hasLyrics])
  @@index([category])
  @@index([isActive])
  @@index([isFree])
  @@map("CalmMusicTrack")
}

model UserPoints {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalPoints Int @default(0)

  spentPoints Int @default(0)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("UserPoints")
}

model UserUnlockedTrack {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trackId String         @db.Uuid
  track   CalmMusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  pointsSpent Int

  unlockedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, trackId])
  @@index([userId])
  @@map("UserUnlockedTrack")
}

model ServicePlan {
  id           String    @id @default(uuid()) @db.Uuid
  code         PlanCode  @unique
  name         String    @db.VarChar(255)
  description  String?   @db.Text
  type         PlanType
  plantMode    PlantMode
  price        Int
  durationDays Int?

  includedSongs  Int @default(0)
  maxRedeemSongs Int @default(0)

  hasAiJournalReply  Boolean @default(false)
  hasMoodAnalytics   Boolean @default(false)
  hasMoodTaskSuggest Boolean @default(false)

  hasRealPlant       Boolean @default(false)
  hasFarmerUpdates   Boolean @default(false)
  updateIntervalDays Int?
  includesShipping   Boolean @default(false)

  hasPotCustom     Boolean @default(false)
  hasGiftCard      Boolean @default(false)
  hasGiftPackaging Boolean @default(false)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  subscriptions UserSubscription[]
  orders        Order[]

  @@map("ServicePlan")
}

model UserSubscription {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  planId String @db.Uuid

  startsAt DateTime  @default(now()) @db.Timestamptz(3)
  endsAt   DateTime? @db.Timestamptz(3)

  isActive  Boolean @default(true)
  autoRenew Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan ServicePlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([isActive])
  @@map("UserSubscription")
}

model Order {
  id        String @id @default(uuid()) @db.Uuid
  orderCode String @unique @db.VarChar(30)

  userId String @db.Uuid
  planId String @db.Uuid

  status        OrderStatus    @default(PENDING)
  paymentMethod PaymentMethod?
  paidAt        DateTime?      @db.Timestamptz(3)

  subtotalAmount Int
  shippingFee    Int @default(0)
  discountAmount Int @default(0)
  totalAmount    Int

  recipientType    GiftRecipientType @default(SELF)
  recipientName    String?           @db.VarChar(200)
  recipientPhone   String?           @db.VarChar(20)
  recipientAddress String?           @db.Text
  recipientNote    String?           @db.Text

  giftMessage     String? @db.Text
  giftCardTheme   String? @db.VarChar(100)
  potCustomOption String? @db.VarChar(255)
  packagingOption String? @db.VarChar(255)

  shippingStatus ShippingStatus @default(PENDING)

  realPlantId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      ServicePlan @relation(fields: [planId], references: [id])
  realPlant RealPlant?  @relation(fields: [realPlantId], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([createdAt])
  @@map("Order")
}

enum AchievementCategory {
  TREE_CARE
  WELLNESS
  JOURNAL
  JOURNEY
}

model AchievementDefinition {
  id             String              @id @default(uuid()) @db.Uuid
  slug           String              @unique @db.VarChar(100)
  title          String              @db.VarChar(255)
  description    String              @db.Text
  emoji          String              @db.VarChar(10)
  category       AchievementCategory
  requirement    String              @db.VarChar(500)
  progressKey    String              @db.VarChar(100)
  targetProgress Int
  sortOrder      Int                 @default(0)
  isActive       Boolean             @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  userAchievements UserAchievement[]

  @@index([category])
  @@index([isActive])
  @@map("AchievementDefinition")
}

model UserAchievement {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  achievementId String                @db.Uuid
  achievement   AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  progress   Int       @default(0)
  unlocked   Boolean   @default(false)
  unlockedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([userId, unlocked])
  @@map("UserAchievement")
}

model FlowerHarvest {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  virtualPlantId String       @db.Uuid
  virtualPlant   VirtualPlant @relation(fields: [virtualPlantId], references: [id], onDelete: Cascade)

  flowerTypeId   String     @db.Uuid
  flowerType     FlowerType @relation(fields: [flowerTypeId], references: [id], onDelete: Restrict)

  flowerName     String  @db.VarChar(255)

  flowerImageUrl String? @db.VarChar(500)

  nickname       String? @db.VarChar(100)

  growthDays     Int     @default(0)

  harvestedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([userId, flowerTypeId])
  @@index([harvestedAt])
  @@map("FlowerHarvest")
}

// ─────────────────────────────────────────
// COMPANION MATCHING FEATURE
// ─────────────────────────────────────────

enum CompanionMode {
  SPONSOR_GROWER // muốn nhờ/tài trợ người trồng (không có thời gian)
  GROWER_GROWER  // đang trồng thật, muốn tìm bạn cùng hành trình
  OPEN           // mở - bất kỳ ai, chỉ muốn kết nối qua cây
}

enum CompanionRequestStatus {
  PENDING
  MATCHED
  CANCELLED
}

enum CompanionshipStatus {
  ACTIVE
  ENDED
}

model CompanionRequest {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mode     CompanionMode
  moodNote String?                @db.Text
  status   CompanionRequestStatus @default(PENDING)

  companionshipId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([status, mode])
  @@map("CompanionRequest")
}

model Companionship {
  id String @id @default(uuid()) @db.Uuid

  user1Id String @db.Uuid
  user1   User   @relation("CompanionUser1", fields: [user1Id], references: [id], onDelete: Restrict)

  user2Id String @db.Uuid
  user2   User   @relation("CompanionUser2", fields: [user2Id], references: [id], onDelete: Restrict)

  mode   CompanionMode
  status CompanionshipStatus @default(ACTIVE)

  // Cây thật đang cùng theo dõi (optional — do người trồng quyết định chia sẻ)
  realPlantId String?    @db.Uuid
  realPlant   RealPlant? @relation(fields: [realPlantId], references: [id], onDelete: SetNull)

  startedAt DateTime  @default(now()) @db.Timestamptz(3)
  endedAt   DateTime? @db.Timestamptz(3)
  endReason String?   @db.VarChar(255)

  messages CompanionMessage[]

  @@index([user1Id])
  @@index([user2Id])
  @@index([status])
  @@map("Companionship")
}

model CompanionMessage {
  id              String        @id @default(uuid()) @db.Uuid
  companionshipId String        @db.Uuid
  companionship   Companionship @relation(fields: [companionshipId], references: [id], onDelete: Cascade)

  senderId String @db.Uuid
  sender   User   @relation("CompanionMessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  content String  @db.Text
  isRead  Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([companionshipId, createdAt])
  @@index([senderId])
  @@map("CompanionMessage")
}
